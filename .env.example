[TEMPLATE]
# RPC endpoints
# Arbitrum One (go-live network, chainId 42161). The default public endpoint
# https://arb1.arbitrum.io/rpc works, but for a live bot use a dedicated
# provider key (Alchemy/QuickNode/etc.) — rate limits + uptime matter.
ARBITRUM_RPC_URL=
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=

# Deployer key (never commit the real .env)
PRIVATE_KEY=

# Optional: override the Aave V3 PoolAddressesProvider per network.
# Defaults: arbitrum 0xa97684ead0e402dC232d5A977953DF7ECBaB3CDb (verified:
#              Pool 0x794a61358D6845594F94dc1DB02A252b5b4814aD, premium 5 bps,
#              WETH reserve ~97.6k WETH)
#           sepolia   0x012bAC54348C0E635dCAc9D5FB99f06F24136C9A
#           mainnet   0x2f39d218133AFaB8F2B819B1066c7E434Ad94E9e
POOL_ADDRESSES_PROVIDER=

# --- Balancer V2 engine (scripts/deployBalancerFlashLoan.js) ---------------
# Wallet that receives every trade's profit automatically (same transaction;
# no withdraw() wait). Required at engine construction — the deploy script
# defaults to 0xEfB4e57F8DD5d6b89C3f20aCc5Ad42Ff75b38910 if unset.
PROFIT_RECIPIENT=
# Optional: override the Balancer V2 Vault per network.
# Defaults: arbitrum + sepolia + mainnet 0xBA12222222228d8Ba445958a75a0704d566BF2C8
# (on-chain verified on Arbitrum: holds ~103.7 WETH)
BALANCER_VAULT=

# Scanner overrides (all optional; config.json is the primary source)
ENGINE_ADDRESS=
ROUTE_STRATEGY_ADDRESS=

# Opportunity alerts: webhook URL receiving POST JSON (Slack/Discord/Telegram
# bridge). Kept in .env because webhook URLs usually embed a secret token.
ALERT_WEBHOOK_URL=

# F1 fix: minimum gas price (wei) the profitability gate may assume. Set it
# to >= what your sender actually pays so the decision can never underprice
# gas and pass a money-losing trade.
#   Arbitrum: min is 0.02 gwei (20000000 wei, verified on-chain via
#             ArbGasInfo.getMinimumGasPrice); L1 data fee is already folded
#             into eth_estimateGas by the Arbitrum node, so estimateGas*
#             gasPrice is the full cost on L2. 50000000 (0.05 gwei) is a
#             sensible live floor.
#   Sepolia:  2000000000 (2 gwei — what run 8 actually paid)
GAS_PRICE_FLOOR_WEI=

# Private submission RPC used ONLY for sending (needs PRIVATE_KEY above).
# IMPORTANT — network-dependent:
#   Ethereum L1 ONLY (Flashbots Protect — hides the tx from the public
#   mempool and does not include reverting transactions by default, so a
#   failed trade costs no gas):
#     Sepolia:  https://rpc-sepolia.flashbots.net/
#     Mainnet:  https://rpc.flashbots.net/fast
#   Arbitrum: Flashbots Protect does NOT support Arbitrum (chainId 42161 is
#   not in its supported-networks list). On Arbitrum the sequencer's mempool
#   is already private (txs are not observable pre-inclusion the way L1
#   public-mempool txs are), and MEV protection is a provider feature — e.g.
#   an Alchemy or QuickNode Arbitrum endpoint with MEV protection enabled
#   (QuickNode: no public fallback if private routing fails). Leave empty to
#   submit through the normal RPC.
SUBMIT_RPC_URL=

# Optional Tenderly preflight (fail-closed): every send is dry-run against
# Tenderly's simulate API first; a revert there blocks the broadcast.
# Requires a Tenderly paid plan. See scanner/lib/tenderly.js.
TENDERLY_ACCESS_TOKEN=
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=
